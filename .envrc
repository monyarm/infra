# 1. Use the optimized nix-direnv loader
# This caches the devShell environment so it loads instantly.
use flake .

# /build-locks: flocks build scripts take on themselves (see dynamic.nix's
# dynamic-optimize.lock). unrelated to secrets, always set up.
mkdir -p /tmp/build-locks
setfacl -m g:nixbld:rwx /tmp/build-locks
# default ACL too -- else a lock file made by one build's nixbldN user has
# no group-write, and a different concurrent build's user can't flock it.
setfacl -d -m g:nixbld:rwx /tmp/build-locks
export NIX_CONFIG="extra-sandbox-paths = /build-locks=/tmp/build-locks?"

# TODO: add these keys to secrets/env.json for the new fetchers to work:
#   GOG_REFRESH_TOKEN, NEXUS_API_KEY, CURSEFORGE_API_KEY, MODIO_API_KEY, EPIC_LEGENDARY_AUTH

# 2. Define secret paths
SECRET_JSON="secrets/env.json"
TARGET_ENV=".env"

# 3. Decrypt and load secrets
if [ -f "$SECRET_JSON" ]; then
    echo "🔐 Decrypting secrets via sops..."
    
    # Decrypt JSON to standard ENV variables and save to .env. Values are
    # shell-quoted via @sh (and non-string values flattened to JSON text
    # first) since some secrets (e.g. GOG_AUTH) contain characters like
    # quotes/#/! that break naive "export KEY=\"$value\"" sourcing.
    sops -d "$SECRET_JSON" | jq -r 'to_entries | .[] | "export \(.key)=\((.value | if type == "string" then . else tojson end) | @sh)"' > "$TARGET_ENV"
    
    # Load the local .env into the current environment
    dotenv "$TARGET_ENV"
    
    if [ -f .env ]; then
        # /steam-session persists DepotDownloader's .NET IsolatedStorage
        # session dir (see lib/fetchers/steam.nix's fetchSteam) across builds,
        # so a Steam login established once doesn't need re-auth (2FA/mobile
        # confirm) every fixed-output build -- each one otherwise gets a
        # throwaway $HOME and looks like a brand-new device to Steam.
        mkdir -p /tmp/steam-session
        setfacl -m g:nixbld:rwx /tmp/steam-session
        # append, don't overwrite -- /build-locks is already in NIX_CONFIG above.
        export NIX_CONFIG="$NIX_CONFIG
extra-sandbox-paths = /secrets=/tmp/.env? /steam-session=/tmp/steam-session?"
        cp .env /tmp/.env
        chmod go-rw /tmp/.env
        setfacl -m g:nixbld:rwx /tmp/.env
    fi
    # Tell nix-direnv to trigger a reload if the secrets file changes
    watch_file "$SECRET_JSON"
else
    echo "⚠️ Warning: $SECRET_JSON not found."
fi
