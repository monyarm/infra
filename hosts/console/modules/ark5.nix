# ARK-5 CFW settings. Both files are `<runlevel>, <name-or-path>, <on|off>`
# CSV; `//`, `;` and `#` start a comment. Formats verified from ARK-5 source,
# see docs/research.md.
{ lib, config, ... }:

let
  inherit (lib)
    mkOption
    types
    ;

  settings = config.psp.cfw.ark5.settings;
  arkPath = config.psp.cfw.ark5.arkPath;

  # Plugins come from the single `psp.plugins` registry, already in load order.
  plugins = config.psp.pluginEntries;

  header = ''
    // Generated by the nix console subsystem. Manual edits are reverted on the
    // next apply. Format: <runlevel>, <name-or-path>, <on|off>.
  '';

  # `<runlevel>, <name>, on|off` for a plain boolean setting. A null value
  # leaves the setting untouched (ARK keeps its own default).
  boolLine =
    name: value: lib.optional (value != null) "always, ${name}, ${if value then "on" else "off"}";

  # `<runlevel>, <name>[:variant], on|off` for a setting with enumerated values.
  # "off" disables the base name; a variant selects `name:variant`.
  variantLine =
    base: variant:
    lib.optional (variant != null) (
      if variant == "off" then "always, ${base}, off" else "always, ${base}:${variant}, on"
    );

  boolSettings = {
    inherit (settings) usbcharge;
    inherit (settings) wpa2;
    inherit (settings) launcher;
    inherit (settings) disablepause;
    inherit (settings) oldplugin;
    inherit (settings) noled;
    inherit (settings) noumd;
    inherit (settings) noanalog;
    inherit (settings) hibblock;
    inherit (settings) hidemac;
    inherit (settings) hidedlc;
    inherit (settings) deadef;
    inherit (settings) vitamute;
    inherit (settings) qaflags;
  };

  variantSettings = {
    inherit (settings) cpuclock;
    inherit (settings) highmem;
    inherit (settings) mscache;
    inherit (settings) infernocache;
    inherit (settings) skiplogos;
    inherit (settings) hidepics;
  };

  settingLines = lib.flatten (
    lib.mapAttrsToList (name: value: boolLine name value) boolSettings
    ++ lib.mapAttrsToList (base: variant: variantLine base variant) variantSettings
  );

  variantOption =
    { base, values }:
    mkOption {
      type = types.nullOr (types.enum ([ "off" ] ++ values));
      default = null;
      description = ''
        ARK-5 `${base}`. `"off"` disables it; otherwise choose a value, written
        as `${base}:<value>`.
      '';
    };

  pluginEntry = p: "${p.runlevel}, ${p.devicePath}, on";
in
{
  options.psp.cfw.ark5 = {
    enable = mkOption {
      type = types.bool;
      default = false;
      description = "Generate ARK-5 configuration files (SETTINGS.TXT, PLUGINS.TXT).";
    };

    arkPath = mkOption {
      type = types.str;
      default = "PSP/SAVEDATA/ARK_01234";
      description = ''
        Card-relative ARK installation directory holding SETTINGS.TXT. Must
        match the real install location. ARK-5's compiled default is
        `ms0:/PSP/SAVEDATA/ARK_01234`.
      '';
    };

    settings = mkOption {
      type = types.submodule {
        options = {
          usbcharge = mkOption {
            type = types.nullOr types.bool;
            default = null;
          };
          wpa2 = mkOption {
            type = types.nullOr types.bool;
            default = null;
          };
          launcher = mkOption {
            type = types.nullOr types.bool;
            default = null;
          };
          disablepause = mkOption {
            type = types.nullOr types.bool;
            default = null;
          };
          oldplugin = mkOption {
            type = types.nullOr types.bool;
            default = null;
          };
          noled = mkOption {
            type = types.nullOr types.bool;
            default = null;
          };
          noumd = mkOption {
            type = types.nullOr types.bool;
            default = null;
          };
          noanalog = mkOption {
            type = types.nullOr types.bool;
            default = null;
          };
          hibblock = mkOption {
            type = types.nullOr types.bool;
            default = null;
          };
          hidemac = mkOption {
            type = types.nullOr types.bool;
            default = null;
          };
          hidedlc = mkOption {
            type = types.nullOr types.bool;
            default = null;
          };
          deadef = mkOption {
            type = types.nullOr types.bool;
            default = null;
          };
          vitamute = mkOption {
            type = types.nullOr types.bool;
            default = null;
          };
          qaflags = mkOption {
            type = types.nullOr types.bool;
            default = null;
          };

          cpuclock = variantOption {
            base = "cpuclock";
            values = [
              "133"
              "222"
              "333"
              "383"
              "403"
              "423"
              "443"
            ];
          };
          highmem = variantOption {
            base = "highmem";
            values = [
              "auto"
              "force16"
              "forcemax"
            ];
          };
          mscache = variantOption {
            base = "mscache";
            values = [
              "4k"
              "8k"
              "16k"
            ];
          };
          infernocache = variantOption {
            base = "infernocache";
            values = [
              "lru"
              "rr"
            ];
          };
          skiplogos = variantOption {
            base = "skiplogos";
            values = [
              "gameboot"
              "coldboot"
            ];
          };
          hidepics = variantOption {
            base = "hidepics";
            values = [
              "pic0"
              "pic1"
            ];
          };
        };
      };
      default = { };
      description = "ARK-5 settings written to SETTINGS.TXT.";
    };

  };

  config.psp.files = lib.mkMerge [
    (lib.mkIf (config.psp.cfw.ark5.enable && settingLines != [ ]) {
      "${arkPath}/SETTINGS.TXT" = {
        text = header + lib.concatStringsSep "\n" settingLines + "\n";
        owner = "cfw.ark5";
      };
    })
    (lib.mkIf (config.psp.cfw.ark5.enable && plugins != [ ]) {
      "SEPLUGINS/PLUGINS.TXT" = {
        text = header + lib.concatStringsSep "\n" (map pluginEntry plugins) + "\n";
        owner = "cfw.ark5";
      };
    })
  ];
}
