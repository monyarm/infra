// Purpose-built map shuffler for the WadFusion roguelike stack.
//
// Reads the "ROGUEMAPS" lump (one map name per line, generated by
// build_custom_maps.py from doom_fusion.ipk3's own maps/ plus every map
// pulled in from the community-megawad pool) and shuffles among exactly
// those names. Deliberately not MOShuffle: its own map-discovery scans
// MAPINFO text for an unbroken sequential MAP01/MAP02/... run and stops at
// the first mismatch, which never holds once multiple differently-prefixed
// sources are combined (checked directly against its ZScript source, not
// assumed). We already know the exact map list at build time, so there's
// nothing to discover at runtime -- just shuffle it.
//
// Structure (event handler + a persistent Thinker holding the deck, writing
// GZDoom's own level.NextMap/NextSecretMap fields on each transition) is
// the same proven approach MOShuffle itself uses.

class RoguelikeShuffleHandler : StaticEventHandler
{
    RoguelikeShuffleThinker GetThinker()
    {
        ThinkerIterator ti = ThinkerIterator.Create("RoguelikeShuffleThinker", Thinker.STAT_STATIC);
        let mo = RoguelikeShuffleThinker(ti.Next());
        if (!mo)
        {
            mo = new("RoguelikeShuffleThinker");
        }
        return mo;
    }

    override void WorldLoaded(WorldEvent e)
    {
        if (Level.MapName ~== "TITLEMAP")
        {
            return;
        }
        let mo = GetThinker();
        if (e.IsSaveGame || e.IsReopen)
        {
            mo.ApplyCurrent();
            return;
        }
        mo.Advance();
    }

    override void WorldTick()
    {
        if (Level.MapName ~== "TITLEMAP")
        {
            return;
        }
        let mo = GetThinker();
        if (Level.Time == 1)
        {
            mo.Init();
        }
    }
}

class RoguelikeShuffleThinker : Thinker
{
    Array<String> maps;
    int pos;
    bool started;

    void Init()
    {
        ChangeStatNum(STAT_STATIC);
        if (!started)
        {
            LoadMaps();
            Shuffle();
            pos = 0;
            started = true;
            if (maps.Size() > 0)
            {
                level.NextMap = maps[0];
                level.NextSecretMap = maps[0];
                Exit_Normal(0);
            }
            return;
        }
        ApplyCurrent();
    }

    void LoadMaps()
    {
        int lump = Wads.CheckNumForName("ROGUEMAPS");
        if (lump < 0)
        {
            Console.Printf("RoguelikeShuffle: no ROGUEMAPS lump found, nothing to shuffle.");
            return;
        }
        String buf = Wads.ReadLump(lump);
        Array<String> lines;
        buf.Split(lines, "\n", TOK_SKIPEMPTY);
        for (int i = 0; i < lines.Size(); i++)
        {
            String s = lines[i];
            s.Replace("\r", "");
            if (s.Length() > 0)
            {
                maps.Push(s);
            }
        }
    }

    void Shuffle()
    {
        // Fisher-Yates.
        for (int i = maps.Size() - 1; i > 0; i--)
        {
            int j = Random(0, i);
            String t = maps[i];
            maps[i] = maps[j];
            maps[j] = t;
        }
    }

    void Advance()
    {
        if (maps.Size() == 0)
        {
            return;
        }
        pos++;
        if (pos >= maps.Size())
        {
            pos = 0;
        }
        ApplyCurrent();
    }

    void ApplyCurrent()
    {
        if (maps.Size() == 0)
        {
            return;
        }
        level.NextMap = maps[pos];
        level.NextSecretMap = maps[pos];
    }
}
